# Runtime data only; use an absolute persistent directory on your server.
DATA_DIR=./data

# Optional. Local defaults to filesystem storage; Vercel selects Blob automatically.
# STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN is supplied by the connected Vercel Blob store. Keep it secret.

# Browser origin; HTTPS is required in production except for loopback testing.
APP_URL=http://localhost:3000

# Run npm run setup-admin to generate these in .env.local.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional deployment subpath. Set before npm run build.
# BASE_PATH=/bookshelf
