# Book files default to the Git-tracked data/books. For self-hosted private training,
# use an absolute persistent DATA_DIR containing books/, training/ and auth/.
DATA_DIR=./data

# Books on Vercel read only from the Git deployment; no Blob or book environment setup.
# Private training and login use filesystem storage locally, or a private Blob store on Vercel.
# Optional for private runtime data only:
# STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN is supplied by the connected private store. Keep it secret.

# Browser origin; HTTPS is required in production except for loopback testing.
APP_URL=http://localhost:3000

# Run npm run setup-admin to generate these in .env.local.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional deployment subpath. Set before npm run build.
# BASE_PATH=/bookshelf

# Optional image analysis. Keep the key server-side; selected frames are sent only on confirmation.
# OPENAI_API_KEY=
# TRAINING_AI_MODEL=gpt-4.1-mini
# Optional publicly readable MediaPipe model mirror, or a same-origin pathname.
# TRAINING_POSE_MODEL_URL=https://your-static-host/pose_landmarker_lite.task
