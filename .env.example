# Book content plus local runtime state. Vercel reads the repository's data/books without this variable.
DATA_DIR=./data

# Browser origin for the local editor; Vercel's public, read-only site does not need this setting.
APP_URL=http://localhost:3000

# Run npm run setup-admin to generate these in .env.local.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional deployment subpath. Set before npm run build.
# BASE_PATH=/bookshelf
